# Copie para .env e preencha. NÃO comitar o .env real.

# --- Banco / fila ---
DATABASE_URL=postgresql+psycopg://radar3d:radar3d@db:5432/radar3d
REDIS_URL=redis://redis:6379/0

# --- API ---
API_CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# --- Fontes (ver docs/fontes.md) ---
# Cults3D — API GraphQL oficial (HTTP Basic: usuário + API key)
CULTS3D_USERNAME=
CULTS3D_API_KEY=

# Thingiverse — App Token (crie em thingiverse.com/developers/my-apps)
THINGIVERSE_APP_TOKEN=

# MyMiniFactory — API key (query param `key`; crie na sua conta MMF)
MYMINIFACTORY_API_KEY=

# --- Embeddings (definir na Fase 0: self-host vs API) ---
EMBEDDINGS_PROVIDER=stub

# --- Tradução PT->EN (none | argos). No compose o worker usa argos. ---
TRANSLATE_PROVIDER=none

# --- Coletor Shopee (ver docs/fontes.md) ---
# stub (mock) | affiliate (API oficial) | apify (actor pago por resultado)
SHOPEE_SOURCE=stub
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
# Apify (ponte enquanto a aprovação de afiliado não sai):
APIFY_TOKEN=
APIFY_SHOPEE_ACTOR=viralanalyzer~shopee-affiliate-products
SHOPEE_QUERIES=controller stand,headphone stand,cable organizer
SHOPEE_COLLECT_HOUR=3

# --- Frontend ---
# Browser (client-side) fala com a API por localhost:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server components (dentro do container web) falam pela rede do Docker.
# No compose isto já é definido como http://api:8000; localhost fora do Docker.
API_URL_INTERNAL=http://localhost:8000
